{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/workspaces/NVINDIA_CUD"],
      "enabled": false
    }
  },
  "permission": {
    "bash": "allow",
    "write": "allow",
    "edit": "allow",
    "read": "allow"
  },
  "plugin": [
    "oh-my-openagent@latest",
    "oh-my-opencode-slim"
  ],
  "instructions": [
    "AGENTS.md",
    "docs/PRD.md",
    "docs/TECH_SPEC.md"
  ]
}

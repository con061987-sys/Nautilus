# syntax=docker/dockerfile:1.7
#
# Dockerfile.amd — AMD ROCm 6.0 build & runtime environment for Nautilus.
#
# Provides: ROCm 6.0 stack (HIP, hipcc, AOTriton-compatible runtime),
#           PyTorch (ROCM build via pip extras), Triton, TVM MetaSchedule,
#           XLA, dev tooling, and the full nautilus install.
#
# Build:   docker build -f Dockerfile.amd -t nautilus:amd .
# Run:     docker run --rm --device=/dev/kfd --device=/dev/dri \
#              --group-add video nautilus:amd nautilus verify
#

ARG UBUNTU_VERSION=22.04
FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:6.0 AS base

# ---------------------------------------------------------------------------
# System layer
# ---------------------------------------------------------------------------
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ROCM_PATH=/opt/rocm \
    HIP_PATH=/opt/rocm/hip \
    PATH=/opt/rocm/bin:/opt/rocm/llvm/bin:${PATH} \
    LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/llvm/lib:/opt/rocm/hsa/lib:${LD_LIBRARY_PATH}

# System deps. ROCm base image already ships the ROCm runtime; we add the
# generic build / Python toolchain on top.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gnupg \
        wget \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        libssl-dev \
        zlib1g-dev \
        libbz2-dev \
        libreadline-dev \
        libsqlite3-dev \
        libncursesw5-dev \
        xz-utils \
        tk-dev \
        libxml2-dev \
        libxmlsec1-dev \
        libffi-dev \
        liblzma-dev \
        libgl1 \
        libglib2.0-0 \
        software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-dev \
        python3.10-venv \
        python3.10-distutils \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 100 \
    && update-alternatives --install /usr/bin/python  python  /usr/bin/python3.10 100

# Bootstrap pip.
RUN curl -fsSL https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py \
    && python3 /tmp/get-pip.py \
    && rm -f /tmp/get-pip.py

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
WORKDIR /app

COPY . .

# Install Nautilus with every optional extra + dev tooling. The `amd` and
# `all` extras pull in aotriton 0.10, which is the supported AOT path for
# ROCm/HIP from this framework.
RUN pip install --upgrade pip setuptools wheel \
    && pip install -e ".[all,dev]"

# Verify ROCm toolchain is visible.
RUN (which hipcc && hipcc --version) || (ls /opt/rocm/bin | head) \
    && python -c "import torch; print('torch', torch.__version__, 'hip', getattr(torch.version, 'hip', None), 'avail', torch.cuda.is_available())" \
    && python -c "import triton; print('triton', triton.__version__)" \
    && python -c "import aotriton; print('aotriton', aotriton.__version__)" || true

# ---------------------------------------------------------------------------
# Healthcheck
# ---------------------------------------------------------------------------
HEALTHCHECK --interval=30s --timeout=15s --start-period=20s --retries=3 \
    CMD nautilus verify || exit 1

CMD ["bash"]
